# Number Mayhem - Git ignore file
# These files should NOT be committed to version control

# Python
__pycache__/
*.pyc
*.pyo

# Database files (player data)
*.db

# Virtual environments
venv/
.venv/

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/

# Environment files (secrets - never commit)
.env
.env.*

# Generated / build artifacts and coverage
*.sqlite3
.coverage
htmlcov/
*.egg-info/
dist/
build/